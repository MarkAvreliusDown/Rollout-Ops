# Скопируй этот файл в .env (рядом с manage.py) и заполни своими значениями.
# Сам .env никогда не попадает в git — он в .gitignore.

# --- ИИ (необязательно) ---
# Локальная модель через Ollama (https://ollama.com) — ничего не уходит в интернет.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Telegram-бот (необязательно) ---
# Токен получить у @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=
# chat_id, кому бот будет присылать уведомления. Можно несколько через запятую.
# Узнать свой chat_id можно скриптом get_telegram_chat_id.py (после заполнения TELEGRAM_BOT_TOKEN выше).
TELEGRAM_CHAT_ID=

# --- Пароль на сайт (необязательно) ---
# Если задать — на сайт нельзя будет зайти без этого пароля. Пусто = сайт открыт без пароля.
SITE_PASSWORD=
